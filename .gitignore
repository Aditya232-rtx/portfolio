# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screen recordings - do not commit (user request: exclude screenrecording in /public root ONLY)
# Ignores video files placed directly in /public (e.g. Screen Recording, screenrecording.mp4)
# IMPORTANT: everything in /public/projects MUST be retained - do not ignore that folder
# Patterns below use /public/*.ext so they ONLY match files directly in /public, not /public/projects/
/public/*.mp4
/public/*.mov
/public/*.webm
/public/Screen*.mp4
/public/Screen*.mov
/public/screenrecording*
/public/Screen*Recording*

# dev artifacts - not part of portfolio deploy (raw captures, reference scrape, local claude config)
/_incoming/
/_reference/
/.claude/
*.trace
